# ── App ───────────────────────────────────────────────────────────────────────
# Generate your own secret, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_YOUR_OWN_CRYPTOGRAPHICALLY_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin bootstrap (required when running python create_admin.py)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: mongodb.com → Your Cluster → Connect → Drivers
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=student_digital_twin

# ── AI (Optional) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── SMS (Optional) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── GitHub API (Optional) ─────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
